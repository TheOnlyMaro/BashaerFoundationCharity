<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="12.0" alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.bashaer.bashaerfoundationcharity.controller.UserDashboardController"
      style="-fx-padding: 25;" prefWidth="500">

    <Label text="Donor Portal - Contributions &amp; Modifiers" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TextField fx:id="donorNameField" promptText="Donor Full Name"/>
    <TextField fx:id="amountField" promptText="Monetary Value / Estimated Value ($)"/>

    <!-- Donation Type Selection -->
    <ComboBox fx:id="donationTypeCombo" promptText="Select Donation Type" prefWidth="300"/>

    <!-- Conditional In-Kind Description (No quantity column stored in DB) -->
    <VBox fx:id="inKindBox" spacing="10" managed="false" visible="false">
        <TextField fx:id="itemDescriptionField" promptText="Item Description (e.g., Winter Blankets)"/>
        <TextField fx:id="quantityField" promptText="Quantity (e.g., 50)"/>
    </VBox>

    <!-- Decorator Checkboxes -->
    <CheckBox fx:id="anonymousCheckBox" text="Make Donation Anonymous"/>
    <CheckBox fx:id="processingFeeCheckBox" text="Cover 3% Processing Fee (Monetary only)"/>
    <CheckBox fx:id="logisticsFeeCheckBox" text="Add $15 Logistics Fee (In-Kind only)"/>

    <!-- Strategy Selection -->
    <ComboBox fx:id="receiptStrategyCombo" promptText="Select Receipt Format" prefWidth="300"/>

    <Button text="Submit &amp; Save Donation" onAction="#handleSubmitDonation"
            style="-fx-background-color: #2b7a78; -fx-text-fill: white; -fx-font-weight: bold;"/>

    <!-- Status & Receipt Preview -->
    <Label fx:id="statusLabel" text="" style="-fx-font-weight: bold; -fx-text-fill: #2b7a78;"/>
    <TextArea fx:id="receiptArea" promptText="Generated receipt preview..." prefHeight="120" editable="false"/>

</VBox>