<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.bashaer.bashaerfoundationcharity.controller.UserDashboardController"
      style="-fx-padding: 30;">

    <!-- Logo with proper image nested tag -->
    <ImageView fx:id="logoView" fitHeight="60" fitWidth="60" preserveRatio="true">
        <image>
            <Image url="@../images/logo.png"/>
        </image>
    </ImageView>

    <Label text="Bashaer Foundation - User Control Panel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="donorNameField" promptText="Enter Donor Name"/>
    <TextField fx:id="amountField" promptText="Enter Donation Amount"/>

    <ComboBox fx:id="donationTypeCombo" promptText="Select Donation Type"/>

    <Button text="Submit Donation (Factory / Strategy)" onAction="#handleSubmitDonation" style="-fx-background-color: #2b7a78; -fx-text-fill: white;"/>

    <Label fx:id="statusLabel" text=""/>
</VBox>