<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.bashaer.bashaerfoundationcharity.controller.MainDashboardController"
      prefHeight="600" prefWidth="800" style="-fx-padding: 10;">

    <!-- App Header -->
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 10; -fx-background-color: #2b7a78;">
        <Label text="Bashaer Foundation Management System"
               style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="+ Spawn Volunteer Window" onAction="#handleOpenVolunteerPortal"
                style="-fx-background-color: #3aafa9; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Multi-Role Portals using TabPane -->
    <TabPane fx:id="portalTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- Tab 1: Donor Control Panel -->
        <Tab text="Donor Portal">
            <fx:include source="user_dashboard.fxml"/>
        </Tab>

        <!-- Tab 2: Event Manager Portal (Observer Pattern Demo) -->
        <Tab text="Event Manager Portal">
            <fx:include source="event_manager.fxml"/>
        </Tab>

        <!-- Tab 3: Volunteer Notification Portal -->
        <Tab text="Volunteer Portal">
            <VBox spacing="10" alignment="TOP_CENTER" style="-fx-padding: 10;" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 5;">
                    <Button text="Open Additional Standalone Instance" onAction="#handleOpenVolunteerPortal"
                            style="-fx-background-color: #2b7a78; -fx-text-fill: white; -fx-font-size: 11px;"/>
                </HBox>
                <fx:include source="volunteer_ui.fxml"/>
            </VBox>
        </Tab>

        <!-- Tab 4: CRUD Lookup Tables -->
        <Tab text="Category Management (CRUD)">
            <fx:include source="lookup_view.fxml"/>
        </Tab>

    </TabPane>
</VBox>