<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="15.0" alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.bashaer.bashaerfoundationcharity.controller.EventDashboardController"
      style="-fx-padding: 30;">

    <Label text="Event Management &amp; Volunteer Notifications" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TextField fx:id="eventNameField" promptText="Event Name (e.g., Winter Food Drive)" prefWidth="300"/>

    <ComboBox fx:id="statusCombo" promptText="Select New Status" prefWidth="300"/>

    <Button text="Update Event Status (Triggers Observer)" onAction="#handleStatusUpdate"
            style="-fx-background-color: #3aafa9; -fx-text-fill: white; -fx-font-weight: bold;"/>

    <TextArea fx:id="logArea" promptText="Observer notification logs will appear here..." prefHeight="150" prefWidth="400" editable="false"/>

</VBox>